rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Login ayina users matrame (test mode kaadu).
    // Firebase SMS OTP (Blaze) ki maarite: request.auth.token.phone_number is string kuda add cheyyandi.
    function verified() {
      return request.auth != null;
    }

    // Profile: andaru chadavachu, owner matrame marchagalaru
    match /users/{uid} {
      allow read: if verified();
      allow write: if verified() && request.auth.uid == uid;
    }

    // Phone number -> uid (contacts lo friends ni find cheyyadaniki)
    match /phones/{phone} {
      allow read: if verified();
      // Number tanadi ani SMS tho prove chesina vaallu matrame
      allow write: if verified() && request.resource.data.uid == request.auth.uid;
    }

    // Postman: message pampadam (sender), teeskovadam + delete (receiver matrame)
    match /inbox/{uid}/msgs/{id} {
      allow create, update: if verified() && request.resource.data.from == request.auth.uid;
      allow read, delete: if verified() && request.auth.uid == uid;
    }

    // Photo / video / voice chunks (deliver ayyaka delete)
    match /inbox/{uid}/chunks/{id} {
      allow create, update: if verified() && request.resource.data.from == request.auth.uid;
      allow read, delete: if verified() && request.auth.uid == uid;
    }

    // Ticks (delivered / read)
    match /inbox/{uid}/receipts/{id} {
      allow create, update: if verified() && request.resource.data.by == request.auth.uid;
      allow read, delete: if verified() && request.auth.uid == uid;
    }

    // Groups: members matrame chudagalaru
    match /groups/{gid} {
      allow read: if verified() && request.auth.uid in resource.data.members;
      allow create: if verified()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.admins == [request.auth.uid];
      // Admin: add / remove. Member: tanu tane exit avvachu.
      allow update: if verified() && (
        request.auth.uid in resource.data.admins ||
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && request.resource.data.name == resource.data.name)
      );
    }

    // 📞 Calls: caller / callee matrame
    match /calls/{cid} {
      allow create: if verified() && request.resource.data.from == request.auth.uid;
      allow read, update: if verified()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      match /{side}/{cand} {
        allow read, create: if verified();
      }
    }

    // Optional TURN server config (console lo matrame edit)
    match /config/{doc} {
      allow read: if verified();
    }
  }
}
